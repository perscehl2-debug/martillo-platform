# Supabase - Get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Kling AI - Get from https://kling.ai/app/dev
KLING_API_KEY=your-kling-api-key-here

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Siniestros (módulo de finiquitización SOAP)
# API key de ORGANIZACIÓN con acuerdo de no entrenamiento / retención cero (datos de salud = sensibles)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Opcional: modelo para extracción/análisis (por defecto claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
# Secreto que Vercel Cron envía como Bearer al sincronizar la UF diaria
CRON_SECRET=your-random-cron-secret
